{
  "name": "kogi-rifas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @kogi-rifas/api --filter @kogi-rifas/web dev",
    "dev:api": "pnpm --filter @kogi-rifas/api dev",
    "dev:web": "pnpm --filter @kogi-rifas/web dev",
    "build": "pnpm --filter @kogi-rifas/api build && pnpm --filter @kogi-rifas/web build",
    "typecheck": "pnpm --filter @kogi-rifas/api typecheck && pnpm --filter @kogi-rifas/web typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.0",
    "@types/node": "^22.20.1",
    "prisma": "^6.16.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.0"
}
