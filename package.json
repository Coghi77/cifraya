{
  "name": "cifraya",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @cifraya/api --filter @cifraya/web dev",
    "dev:api": "pnpm --filter @cifraya/api dev",
    "dev:web": "pnpm --filter @cifraya/web dev",
    "build": "pnpm --filter @cifraya/api build && pnpm --filter @cifraya/web build",
    "typecheck": "pnpm --filter @cifraya/api typecheck && pnpm --filter @cifraya/web typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.16.0",
    "@types/node": "^22.20.1",
    "prisma": "^6.16.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
