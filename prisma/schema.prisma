generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  LIVE
  PAUSED
  CLOSED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum ReservationStatus {
  ACTIVE
  PENDING_REVIEW
  EXPIRED
  CANCELLED
  CONFIRMED
}

model Campaign {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String         @default("")
  prize          String
  prizeCount     Int            @default(1)
  secondPrize    String?
  thirdPrize     String?
  imageUrl       String?
  priceCrc       Int
  numberCount    Int
  numberWidth    Int
  invertedEnabled Boolean        @default(false)
  invertedPrizeEnabled Boolean   @default(false)
  status         CampaignStatus @default(DRAFT)
  drawDate       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  numbers        EntryNumber[]
  reservations   Reservation[]
  photos         CampaignPhoto[]
  packages       PricePackage[]
  winners        Winner[]
  proposals      NumberProposal[]
}

model NumberProposal {
  id          String   @id @default(cuid())
  campaignId  String
  sessionKey  String
  values      Int[]    @default([])
  changesUsed Int      @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sessionKey])
  @@index([expiresAt])
}

model PricePackage {
  id         String   @id @default(cuid())
  campaignId String
  quantity   Int
  priceCrc   Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, quantity])
}

model Winner {
  id            String      @id @default(cuid())
  campaignId    String
  reservationId String
  numberValue   Int
  position      Int         @default(1)
  publishedAt   DateTime    @default(now())
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@unique([campaignId, position])
  @@unique([campaignId, numberValue])
}

model CampaignPhoto {
  id         String   @id @default(cuid())
  campaignId String
  mimeType   String
  data       Bytes
  sortOrder  Int
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
}

model EntryNumber {
  id             String        @id @default(cuid())
  campaignId     String
  value          Int
  status         NumberStatus  @default(AVAILABLE)
  reservationId  String?
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reservation    Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([campaignId, value])
  @@index([campaignId, status])
  @@index([reservationId])
}

model Reservation {
  id             String            @id @default(cuid())
  lookupToken    String            @unique
  campaignId     String
  buyerName      String
  buyerEmail     String
  buyerPhone     String
  selectedValues Int[]             @default([])
  baseValues     Int[]             @default([])
  includesInverted Boolean         @default(false)
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime
  totalCrc       Int               @default(0)
  confirmedAt    DateTime?
  proofSubmittedAt DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  campaign       Campaign          @relation(fields: [campaignId], references: [id])
  numbers        EntryNumber[]
  winners        Winner[]
  proofs         PaymentProof[]

  @@index([status, expiresAt])
}

model PaymentProof {
  id            String      @id @default(cuid())
  reservationId String
  mimeType      String
  data          Bytes
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}
